{
  "name": "satellion",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json --noEmit",
    "build": "pnpm check && vite build",
    "fix": "pnpm exec biome check --write",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "svelte": "^5.0.0",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@tauri-apps/cli": "^2.9.6",
    "typescript": "~6.0.2",
    "vite": "^7.2.7",
    "husky": "^9.1.7",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0"
  }
}
